// SGG Ventures LLC — Website Database Schema
//
// Local development uses SQLite (DATABASE_URL=file:./prisma/dev.db).
// For production, point DATABASE_URL at PostgreSQL — no schema changes
// are required; only the datasource provider below.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite" // switch to "postgresql" for production
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Project enquiries (contact form)
//
// Column names predate the SGG Ventures form; the mapping is:
//   fullName → name        company  → business name
//   division → project type (websites | business-applications | automation | support | not-sure)
//   message  → project description
// phone, country and service are no longer collected and stay null for new rows.
// ---------------------------------------------------------------------------
model Inquiry {
  id            String   @id @default(cuid())
  fullName      String
  company       String?
  email         String
  phone         String?
  country       String?
  division      String
  service       String?
  message       String
  budget        String?  // optional, free text
  timeline      String?  // optional, free text
  consent       Boolean // privacy policy acknowledgement — must be true
  status        String   @default("new") // new | in-review | responded | closed
  notes         String?  // internal administrative notes
  sourcePage    String?  // page that submitted the inquiry
  submittedIp   String?  // coarse IP for spam analysis (hashed)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@map("inquiries")
}

// ---------------------------------------------------------------------------
// Partnership inquiries — legacy table. The public partnership form has been
// retired; the table is kept so existing rows remain readable in the portal.
// ---------------------------------------------------------------------------
model PartnershipInquiry {
  id           String   @id @default(cuid())
  organization String
  contactName  String
  email        String
  phone        String?
  country      String
  partnerType  String // technology | implementation | professional-advisory | managed-services | institutional
  capabilities String   // description of proposed partnership
  website      String?
  consent      Boolean
  status       String   @default("new")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@map("partnership_inquiries")
}

// ---------------------------------------------------------------------------
// Accounts and sessions. Passwords are scrypt hashes. Session cookies store
// a random token; only its SHA-256 hash is kept here.
// ---------------------------------------------------------------------------
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  organization   String?
  passwordHash   String
  role           String // admin | client
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions    Session[]
  engagements Engagement[]        @relation("ClientFiles")
  updates     EngagementUpdate[]

  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// A client file: one engagement, one service area, a named delivery role.
model Engagement {
  id            String   @id @default(cuid())
  clientId      String
  client        User     @relation("ClientFiles", fields: [clientId], references: [id])
  title         String
  division      String // service area slug (see Inquiry.division)
  status        String   @default("intake") // intake | active | waiting-on-partner | closed
  delivery      String   @default("coordination") // direct | partner | coordination
  partnerName   String?
  summary       String
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updates       EngagementUpdate[]

  @@index([clientId, status])
  @@map("engagements")
}

model EngagementUpdate {
  id              String     @id @default(cuid())
  engagementId    String
  engagement      Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  authorId        String
  author          User       @relation(fields: [authorId], references: [id])
  body            String
  visibleToClient Boolean    @default(true)
  createdAt       DateTime   @default(now())

  @@index([engagementId, createdAt])
  @@map("engagement_updates")
}

// ---------------------------------------------------------------------------
// Audit log — administrative actions must be traceable.
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  actor     String // admin user identity ("admin" while single-admin)
  action    String // e.g. "inquiry.status.change"
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}
