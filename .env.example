# SGG Ventures LLC website — environment variables
# Copy to .env.local and fill in values. Never commit real secrets.
# Every variable without the NEXT_PUBLIC_ prefix stays on the server.

# ---------------------------------------------------------------------------
# Database (required)
# Enquiries are stored here; the form reports an error if it is unreachable.
# Local development uses SQLite. For production, set a hosted PostgreSQL URL
# and change `provider` in prisma/schema.prisma to "postgresql".
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Enquiry notification email (optional, via Resend)
# All three must be set for emails to be sent. If any is missing, enquiries
# are still stored and shown in the staff portal, and the notification is
# written to the server log instead. There are no default addresses.
#   INQUIRY_NOTIFY_EMAIL — the monitored inbox that receives enquiries
#   INQUIRY_FROM_EMAIL   — a sender on a domain verified in Resend,
#                          e.g. "SGG Ventures <website@your-domain>"
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
INQUIRY_NOTIFY_EMAIL=""
INQUIRY_FROM_EMAIL=""

# ---------------------------------------------------------------------------
# Site URL — canonical URLs, sitemap, Open Graph. Set to the production
# origin, no trailing slash. On Vercel the production domain is used when
# this is missing; locally it falls back to http://localhost:3000.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# Staff portal
# ADMIN_EMAIL: a Clerk user whose verified primary email matches this address
# is given the staff role. ADMIN_PASSWORD is no longer used (Clerk handles
# passwords).
# ADMIN_SESSION_SECRET also salts the network fingerprint used to rate-limit
# the enquiry form: use a long random value in production.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""


# ---------------------------------------------------------------------------
# Clerk authentication (https://dashboard.clerk.com → API keys)
# In local development Clerk can run without keys ("keyless" mode) and will
# print a link to claim the temporary application. Production needs both.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
